{
	"folders": [
		{
			"path": ".."
		}
	],
	"settings": {},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Analyze code",
				"command": "roslynator",
				"type": "process",
				"args": [
					"analyze",
					"--severity-level",
					"hidden"
				],
				"problemMatcher": "$msCompile"
			},
			{
				"label": "Testing with coverage",
				"command": "dotnet",
				"type": "process",
				"args": [
					"test",
					"/p:CollectCoverage=true",
					"/p:CoverletOutputFormat=lcov",
					"/p:CoverletOutput=./lcov.info"
				],
				"problemMatcher": "$msCompile",
				"group": {
					"kind": "test",
					"isDefault": true
				}
			},
			{
				"label": "Generate coverage stats",
				"command": "reportgenerator",
				"type": "shell",
				"args": [
					"-reports:${workspaceFolder}/tests/*/lcov.info",
					"-targetdir:${workspaceFolder}/tests/covstats"
				],
				"problemMatcher": []
			},
			{
				"label": "Add migration",
				"type": "process",
				"command": "dotnet",
				"args": [
					"ef",
					"migrations",
					"add",
					"${input:migration}",
					"--project",
					"./src/Infrastructure/Infrastructure.csproj",
					"--startup-project",
					"./src/Web/Web.csproj",
				],
				"problemMatcher": []
			},
			{
				"label": "Update database",
				"type": "process",
				"command": "dotnet",
				"args": [
					"ef",
					"database",
					"update",
					"--project",
					"./src/Infrastructure/Infrastructure.csproj",
					"--startup-project",
					"./src/Web/Web.csproj",
				],
				"problemMatcher": []
			},
		],
		"inputs": [
			{
				"id": "migration",
				"description": "migration: Name of database migration",
				"default": "Migration",
				"type": "promptString"
			},
		]
	},
}